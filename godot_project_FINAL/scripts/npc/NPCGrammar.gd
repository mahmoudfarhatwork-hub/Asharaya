static var _slot_re: RegEx = null


# ───── توسيع القالب: اختيارات [أ|ب] ثم الـ slots ثم تنظيف ─────
static func expand(template: String, slots: Dictionary, rng: RandomNumberGenerator) -> String:
	var out := ""
	var i: int = 0
	while i < template.length():
		var ch: String = template[i]
		if ch == "[":
			var j: int = template.find("]", i)
			if j == -1:
				out += ch
				i += 1
				continue
			var options: PackedStringArray = template.substr(i + 1, j - i - 1).split("|", true)
			out += options[rng.randi() % options.size()]
			i = j + 1
		else:
			out += ch
			i += 1
	for k in slots:
		out = out.replace("{%s}" % str(k), str(slots[k]))
	if _slot_re == null:
		_slot_re = RegEx.new()
		_slot_re.compile("\\{[a-z_]+\\}")
	out = _slot_re.sub(out, "", true)
	return tidy(out)


static func tidy(s: String) -> String:
	var t := s.replace("...", "…")
	while t.contains("  "):
		t = t.replace("  ", " ")
	t = t.replace(" ،", "،").replace(" .", ".").replace(" ؟", "؟").replace(" !", "!")
	t = t.replace("،،", "،").replace("..", ".").replace("؟؟", "؟").replace("….", "…").replace("…،", "…")
	t = t.replace("، .", ".").replace("، ؟", "؟").replace("، !", "!")
	return t.strip_edges()


# تشابه الكلمات بين نصين (Jaccard) — بنستخدمه عشان الـ NPC مايكررش نفسه
static func similarity(a: String, b: String) -> float:
	var sa: Dictionary = {}
	var sb: Dictionary = {}
	for t in a.split(" ", false):
		sa[t] = true
	for t in b.split(" ", false):
		sb[t] = true
	if sa.is_empty() or sb.is_empty():
		return 0.0
	var inter: int = 0
	for k in sa:
		if sb.has(k):
			inter += 1
	var uni: int = sa.size() + sb.size() - inter
	return float(inter) / float(maxi(1, uni))


# بيجرّب كذا عيّنة ويختار الأقل تكرارًا مع آخر ردود الـ NPC
static func pick(key: String, slots: Dictionary, recent: Array, rng: RandomNumberGenerator) -> String:
	var arr: Array = FRAGS.get(key, [])
	if arr.is_empty():
		return ""
	var best: String = ""
	var best_score: float = -1.0
	var tries: int = mini(5, arr.size() * 3)
	for n in tries:
		var cand: String = expand(arr[rng.randi() % arr.size()], slots, rng)
		var worst: float = 0.0
		for r in recent:
			worst = maxf(worst, similarity(cand, str(r)))
		var sc: float = (1.0 - worst) + rng.randf() * 0.25
		if sc > best_score:
			best_score = sc
			best = cand
	return best


# ───── طبقات الأسلوب: رسمي/عامي، عرق، عمر، مزاج، ذكاء ─────
static func formalize(text: String) -> String:
	var words: PackedStringArray = text.split(" ", false)
	var out: Array = []
	for w in words:
		var core: String = w
		var pre: String = ""
		var suf: String = ""
		while core.length() > 1 and "،,.!؟?…:;\"'".contains(core[0]):
			pre += core[0]
			core = core.substr(1)
		while core.length() > 1 and "،,.!؟?…:;\"'".contains(core[core.length() - 1]):
			suf = core[core.length() - 1] + suf
			core = core.substr(0, core.length() - 1)
		if FORMAL_MAP.has(core):
			core = FORMAL_MAP[core]
		out.append(pre + core + suf)
	return " ".join(out)


static func stylize(text: String, mind: NPCMind, player_gender: String, rng: RandomNumberGenerator) -> String:
	var t := text
	# رسمي؟
	var formal: bool = float(mind.traits["formality"]) > 0.68 or mind.rank == "king"
	if formal:
		t = formalize(t)
	# قصير لو ذكاؤه منخفض أو صبره قليل: أول جملتين بس
	if mind.intelligence < 0.45 and rng.randf() < 0.5:
		t = _first_sentences(t, 2)
	# خايف: تهتهة
	if float(mind.mood["fear"]) > 0.6 and rng.randf() < 0.6:
		t = "أ-أ-" + t
	# عمر: الكبير بيقول يا ابني
	if mind.eff_age >= 55.0 and rng.randf() < 0.3 and not formal:
		t = ("يا بنتي، " if player_gender == "female" else "يا ابني، ") + t
	# نكهة العرق
	var fl: Dictionary = NPCLexicon.RACE_FLAVOR.get(mind.race, {"pre": [], "suf": []})
	var pres: Array = fl["pre"]
	var sufs: Array = fl["suf"]
	if pres.size() > 0 and rng.randf() < 0.3:
		t = str(pres[rng.randi() % pres.size()]) + " " + t
	elif sufs.size() > 0 and rng.randf() < 0.2:
		t = t + " " + str(sufs[rng.randi() % sufs.size()])
	# غضبان: علامات تعجب
	if float(mind.mood["anger"]) > 0.6 and not t.ends_with("!"):
		t = t.trim_suffix(".") + "!"
	return tidy(t)


static func _first_sentences(t: String, n: int) -> String:
	var parts: Array = []
	var cur := ""
	var count: int = 0
	for i in t.length():
		var ch: String = t[i]
		cur += ch
		if ch == "." or ch == "؟" or ch == "!" or ch == "?":
			parts.append(cur)
			cur = ""
			count += 1
			if count >= n:
				break
	if count < n and cur != "":
		parts.append(cur)
	return " ".join(parts).strip_edges() if parts.size() > 0 else t
