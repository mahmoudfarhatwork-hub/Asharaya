; Engine configuration file.
; ده بيتكتب عادي وهيشتغل، لكن Input Map لازم تتضاف يدوي من المحرر (موضح في الدليل النهائي)
; لأن صيغة الأحداث (InputEventKey) معقدة ومعرضة للخطأ لو اتكتبت يدوي بره المحرر.

config_version=5

[application]

config/name="Asharaya"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

