[autoload]

GameConfig="*res://scripts/GameConfig.gd"
Perf="*res://scripts/PerformanceManager.gd"
Assets="*res://scripts/AssetAutoLoader.gd"
; Dialogue = عقل الـ NPC بدون AI. للرجوع لـ LLM بدّل المسار لـ res://scripts/NPCDialogueBridge.gd
Dialogue="*res://scripts/npc/NPCBrain.gd"
Behavior="*res://scripts/NPCBehaviorController.gd"
Ambient="*res://scripts/AmbientNPCManager.gd"
Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
NetworkManager="*res://scripts/NetworkManager.gd"
CurrencySystem="*res://scripts/CurrencySystem.gd"
MobileControls="*res://scripts/MobileControls.gd"
HUD="*res://scripts/HUD.gd"
RemotePlayersManager="*res://scripts/RemotePlayersManager.gd"
ChatUI="*res://scripts/ChatUI.gd"
RaceData="*res://scripts/RaceData.gd"
CharacterCreationUI="*res://scripts/CharacterCreationUI.gd"
TimeManager="*res://scripts/TimeManager.gd"

[display]

window/handheld/orientation="landscape"
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="mobile"
